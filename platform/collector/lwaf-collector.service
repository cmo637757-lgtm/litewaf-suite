# lwaf-collector.service —— LiteWAF 日志采集器（S2）
#
# 安装：
#   sudo cp lwaf-collector.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now lwaf-collector
#
# 注意：ExecStart 用绝对路径，WorkingDirectory 固定到 collector 目录，
# 这样 config.ini 里的相对路径（如果有）也只会落到这里，不会跑到别的地方。
[Unit]
Description=LiteWAF log collector (nginx -> MariaDB)
Documentation=file:/opt/litewaf/platform/collector/README.md
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=simple
User=litewaf
Group=litewaf
WorkingDirectory=/opt/litewaf/platform/collector
ExecStart=/usr/bin/python3 /opt/litewaf/platform/collector/lwaf_collect.py --config /opt/litewaf/platform/collector/config.ini
Restart=always
RestartSec=5
# 采集器是「读日志 + 写库」，不需要写任何文件系统路径
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
